---
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import Clip from "../components/Clip.astro";
import Badge from "../components/Badge.astro";
import Faq from "../components/Faq.astro";
import PricingStrip from "../components/PricingStrip.astro";
import TemplateCTA from "../components/TemplateCTA.astro";
import { PRODUCT_NAME, COMPANY, DEMO_URL, TEMPLATE_FILE, mailto } from "../config/product";
import { faqLd, softwareLd } from "../lib/schema";
import { u } from "../lib/url";

const faq = [
  { q: `What is ${PRODUCT_NAME}?`, a: `A browser-based data center simulator by ${COMPANY}: one Excel import becomes a 3D twin with floor, air, water, fire, power, cabling, network, device and token layers, and any power, cooling or network node can be failed to see what goes dark.` },
  { q: "Can I sign up today?", a: "Not yet. The product runs today on demo data and on files you send us; we walk you through your own room on a call. Self-serve accounts and checkout are on the roadmap." },
  { q: "Do I have to install anything?", a: "No. The twin runs in the browser. Zabbix and NetBox connect with a URL and a read-only token; inside your own network the same connectors run in a small agent that only dials out. Any other tool's export comes in as a sheet." },
  { q: "Is this CFD?", a: "No. Air and water layers use a zonal model and every projected number is labelled estimated. It is built for questions like \"what happens if this cooling unit stops\", not for detailed airflow engineering." },
  { q: "How much does it cost?", a: "Monitor is about $5 per rack per month with a $49 minimum. Design is one-time per project from $490. Integrators and MSPs earn a 30 % margin as partners." },
  { q: "Is there a Chinese edition?", a: "Yes. The Chinese-language edition is distributed by our partner CloudSino." },
];
const demoHref = DEMO_URL ?? mailto("DC Sim walkthrough", "Hi Da,\n\nI'd like a walkthrough of DC Sim with our own file.\n\nRacks: \nCompany: \n");
---
<Base
  title={`${PRODUCT_NAME} — Your data center, simulated`}
  description="Turn one Excel file into a 3D twin of your data center. Fail any UPS, feed, switch or cooler and see what goes dark. Built to sit on top of the monitoring you run."
  path=""
  jsonLd={[softwareLd(), ...faqLd(faq)]}
>
  <div class="container">
    <section class="hero">
      <p class="eyebrow">{PRODUCT_NAME} by {COMPANY}</p>
      <h1>Your data center, simulated.</h1>
      <p class="lede">From a spreadsheet to a living 3D twin in minutes. Fail anything. See what goes dark.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={u(TEMPLATE_FILE)} download>Download the Excel template</a>
        <a class="btn btn-ghost" href={demoHref}>{DEMO_URL ? "Open the demo" : "Request a walkthrough"}</a>
      </div>
      <p class="small muted" style="margin-top:12px">Built by data-center people. Runs in the browser. Estimated where we estimate, labelled every time.</p>
      <div class="hero-shot">
        <Shot name="hero-lightsoff" alt="DC Sim with the lights off: a dark data hall where only the server LEDs, the hot- and cold-aisle strips and the NOC wall screen glow." caption="Lights off: what still glows is what is running." eager />
      </div>
    </section>

    <section class="section">
      <h2 style="margin-top:0">What it is</h2>
      <p class="direct-answer">{PRODUCT_NAME} is a browser-based data center simulator. You import one Excel file with your racks, devices, power chain and cables, and get a 3D twin with floor, air, water, fire, power, cabling, network, device and token layers. Click any node, press Fail, and see which racks go dark and which services stop.</p>
    </section>

    <section class="section">
      <h2 style="margin-top:0">Three things nobody else gives you</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3>Design → Monitor in one tool</h3>
          <p>Lay out the room before it exists, with U, weight, breaker and cooling checks as you go. Publish a version, import the as-built, keep the same model as the running twin.</p>
          <p class="small muted">AI design assistant: <Badge kind="roadmap" /></p>
        </div>
        <div class="card">
          <h3>On top of the monitoring you run</h3>
          <p>{PRODUCT_NAME} does not replace your monitoring or DCIM. Zabbix and NetBox connect with a URL and a read-only token: inventory, readings and alarms become the twin. Every other tool comes in as a sheet export.</p>
          <p class="small muted">Zabbix and NetBox: <Badge kind="available" /> · other connectors: <Badge kind="roadmap" /></p>
        </div>
        <div class="card">
          <h3>Device data that knows the hardware</h3>
          <p>Type the model the way the vendor prints it. The catalog fills in size, weight, power, airflow and the parts inside; unknown models become plain boxes you identify later.</p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 style="margin-top:0">How it works</h2>
      <div class="grid grid-3">
        <div class="card"><h3>1. Fill one Excel file</h3><p>Devices is the only required sheet: rack, U and model per row. Cables, Racks, Power, Networks, Cooling and Readings each unlock another layer.</p></div>
        <div class="card"><h3>2. Import</h3><p>Preview, a check list with 3D locations, apply. Re-upload later and see exactly what changed. Values only: formulas, macros and encrypted files are refused.</p></div>
        <div class="card"><h3>3. Fail things first</h3><p>A scenario library built from your own model: feed loss, UPS, cooling, leak, fire, more load. Each run sits next to an untouched baseline.</p></div>
      </div>
    </section>

    <section class="section">
      <h2 style="margin-top:0">The demo moment</h2>
      <div class="grid grid-2">
        <Clip name="feed-a-fails-lightsoff" title="Lose feed A at peak, with the lights off" caption="Lose feed A at peak: single-corded devices go dark, the other PDU overloads, services stop (31 s)." />
        <Clip name="crah-stops" title="Cooling unit AC-1 stops" caption="A cooling unit stops: minutes to 27, 32 and 35 °C, estimated by a zonal model, not CFD (31 s)." />
        <Clip name="leak" title="Manifold leak on a liquid-cooled GPU row" caption="A manifold leaks: litres released (estimated), the valve isolates, tokens lost (31 s)." />
        <Clip name="excel-to-3d" title="From an Excel file to a 3D twin" caption="One Excel file in, the room in 3D, checks pinned, a change list on re-upload (48 s)." />
      </div>
    </section>

    <section class="section">
      <h2 style="margin-top:0">Who it is for</h2>
      <div class="grid grid-3">
        <div class="card"><h3>Operators of 1–50 racks</h3><p>Server rooms, edge sites, colo cages, GPU rooms, universities, hospitals. See your room, find the single points of failure, plan the next row.</p><a href={u("product/")}>The product</a></div>
        <div class="card"><h3>Integrators and MSPs</h3><p>Walk your customer through the data center before it exists, win the project, keep them on the twin after go-live.</p><a href={u("partners/")}>Partner program</a></div>
        <div class="card"><h3>AI infrastructure leads</h3><p>Tokens per second per server, tokens per kWh per rack, and the tokens a failure would cost.</p><a href={u("product/it/")}>IT layers</a></div>
      </div>
    </section>

    <section class="section">
      <h2 style="margin-top:0">Works alongside your tools</h2>
      <p>Zabbix · NetBox · Prometheus and Grafana · SolarWinds · ManageEngine OpManager · Sunbird dcTrack · PRTG · CloudSino. Zabbix and NetBox connect directly <Badge kind="available" />; every other tool reaches the twin as an export through the template sheets.</p>
      <p><a href={u("integrations/")}>Integration status, tool by tool</a></p>
    </section>

    <PricingStrip />
    <Faq items={faq} />
    <TemplateCTA />
  </div>
</Base>

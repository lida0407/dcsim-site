---
import { PRODUCT_NAME, COMPANY, TEMPLATE_FILE } from "../config/product";
import { u } from "../lib/url";

const links = [
  { href: "product/", label: "Product" },
  { href: "integrations/", label: "Integrations" },
  { href: "partners/", label: "Partners" },
  { href: "pricing/", label: "Pricing" },
  { href: "resources/", label: "Resources" },
];
const here = Astro.url.pathname;
const isHere = (href: string) => here.startsWith(u(href));
---
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={u()}>{PRODUCT_NAME} <small>by {COMPANY}</small></a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={u(l.href)} aria-current={isHere(l.href) ? "page" : undefined}>{l.label}</a>)}
      <a class="btn btn-primary" href={u(TEMPLATE_FILE)} download>Excel template</a>
    </nav>
    <details class="menu">
      <summary aria-label="Open menu">Menu</summary>
      <div class="menu-panel">
        {links.map((l) => <a href={u(l.href)}>{l.label}</a>)}
        <a href={u("contact/")}>Contact</a>
        <a href={u(TEMPLATE_FILE)} download>Download the Excel template</a>
      </div>
    </details>
  </div>
</header>

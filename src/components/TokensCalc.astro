---
// Tokens per kWh: tokens/s and watts (+ optional facility overhead) -> tokens per kWh and energy cost per 1M tokens.
---
<section class="calc" id="tokens-calc" aria-labelledby="tc-h">
  <h2 id="tc-h" style="margin-top:0">Tokens per kWh calculator</h2>
  <p class="small muted">Use the server's measured power if you have it. The overhead factor adds the facility's share (cooling, UPS losses); 1.0 means the server alone.</p>
  <div class="grid grid-2">
    <div><label for="tc-tps">Tokens per second (server)</label><input id="tc-tps" type="number" min="0" value="20000" inputmode="numeric" /></div>
    <div><label for="tc-w">Server power (W)</label><input id="tc-w" type="number" min="1" value="6000" inputmode="numeric" /></div>
    <div><label for="tc-pue">Facility overhead factor (PUE)</label><input id="tc-pue" type="number" min="1" step="0.05" value="1.0" inputmode="decimal" /></div>
    <div><label for="tc-tariff">Electricity price per kWh</label><input id="tc-tariff" type="number" min="0" step="0.01" value="0.25" inputmode="decimal" /></div>
  </div>
  <table aria-live="polite">
    <tbody>
      <tr><th scope="row">Tokens per kWh</th><td><output id="tc-out">–</output></td></tr>
      <tr><th scope="row">Energy per 1M tokens</th><td><output id="tc-e">–</output></td></tr>
      <tr><th scope="row">Energy cost per 1M tokens</th><td><output id="tc-cost">–</output></td></tr>
      <tr><th scope="row">Per day at this rate</th><td><output id="tc-day">–</output></td></tr>
    </tbody>
  </table>
  <p class="small muted" style="margin-top:10px">Formula: tokens per kWh = tokens/s × 3,600 ÷ (power in kW × overhead factor). Example: 20,000 tokens/s at 6 kW and factor 1.0 = 12,000,000 tokens per kWh.</p>
</section>
<script>
  const n = (id: string) => Number((document.getElementById(id) as HTMLInputElement).value) || 0;
  const out = (id: string, v: string) => ((document.getElementById(id) as HTMLOutputElement).value = v);
  const big = (x: number) => (x >= 1e6 ? `${(x / 1e6).toFixed(2)} million` : Math.round(x).toLocaleString("en-US"));
  function calc() {
    const tps = n("tc-tps"), kw = n("tc-w") / 1000, pue = Math.max(1, n("tc-pue")), tariff = n("tc-tariff");
    if (!tps || !kw) { out("tc-out", "–"); return; }
    const perKwh = (tps * 3600) / (kw * pue);
    const kwhPerM = 1e6 / perKwh;
    out("tc-out", big(perKwh));
    out("tc-e", `${kwhPerM.toFixed(3)} kWh`);
    out("tc-cost", tariff ? `${(kwhPerM * tariff).toFixed(4)} per 1M tokens (your currency)` : "–");
    out("tc-day", `${big(tps * 86400)} tokens · ${(kw * pue * 24).toFixed(1)} kWh`);
  }
  document.querySelectorAll("#tokens-calc input").forEach((el) => el.addEventListener("input", calc));
  calc();
</script>

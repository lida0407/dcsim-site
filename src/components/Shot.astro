---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props { name: string; alt: string; caption?: string; eager?: boolean }
const { name, alt, caption, eager = false } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/shots/*.png", { eager: true });
const img = files[`../assets/shots/${name}.png`]?.default;
if (!img) throw new Error(`Unknown shot: ${name}`);
const tall = img.height > img.width;
---
<figure class="shot">
  <Image
    src={img}
    alt={alt}
    widths={tall ? [360, 720] : [480, 960, 1440]}
    sizes={tall ? "(max-width: 600px) 90vw, 360px" : "(max-width: 1120px) 100vw, 1088px"}
    format="webp"
    quality={78}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
